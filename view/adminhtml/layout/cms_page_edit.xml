<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Solcart_StageCraft::css/pagebuilder-collaboration.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="solcart.stagecraft.collaboration.init"
                   template="Solcart_StageCraft::collaboration/init.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">
                        Solcart\StageCraft\ViewModel\CollaborationConfig
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
