<script>
require(['jquery'], function ($) {
    'use strict';

    var activateUrl = <?= /* @noEscape */ json_encode($block->getActivateTrialUrl()) ?>,
        statusUrl = <?= /* @noEscape */ json_encode($block->getLicenseStatusUrl()) ?>,
        conversationsUrl = <?= /* @noEscape */ json_encode($block->getConversationsUrl()) ?>,
        clearContextUrl = <?= /* @noEscape */ json_encode($block->getClearContextUrl()) ?>,
        $msg = $('#rb-collab-trial-status-msg'),
        $billingLink = $('#rb-collab-manage-billing-link'),
        $ctxWrap = $('#rb-collab-ctx-table-wrap');

    function esc(val) {
        return $('<div></div>').text(val === null || val === undefined ? '' : String(val)).html();
    }

    function renderContextTable(pages) {
        if (!$ctxWrap.length) {
            return;
        }
        if (!Array.isArray(pages) || !pages.length) {
            $ctxWrap.html(
                '<div style="padding:10px;background:#f8fafc;border:1px solid #e2e8f0;' +
                'border-radius:4px;color:#64748b;">' +
                'No active AI conversations stored in Cloudflare KV for this store domain.' +
                '</div>'
            );
            return;
        }

        var html = '<table style="width:100%;border-collapse:collapse;font-size:11px;">' +
            '<thead><tr style="background:#f1f5f9;border-bottom:1px solid #cbd5e1;text-align:left;">' +
            '<th style="padding:7px 8px;">Page / Entity</th>' +
            '<th style="padding:7px 8px;">Delimited Scopes (Scaffolder vs Blocks)</th>' +
            '<th style="padding:7px 8px;">Context Window Usage</th>' +
            '<th style="padding:7px 8px;text-align:right;">Action</th>' +
            '</tr></thead><tbody>';

        pages.forEach(function (p) {
            var used = p.total_tokens_est || 0,
                max = p.max_tokens_budget || 16000,
                pct = Math.min(100, Math.round((used / max) * 100)),
                barColor = pct > 80 ? '#e11d48' : (pct > 50 ? '#f59e0b' : '#0284c7'),
                scopes = Array.isArray(p.scopes) ? p.scopes : [],
                scopeBadges = scopes.map(function (s) {
                    var badgeBg = s.scope_type === 'scaffolder' ? '#fff1f2' : '#f0f9ff',
                        badgeFg = s.scope_type === 'scaffolder' ? '#be123c' : '#0369a1',
                        compText = s.compacted_count ? (' • ' + s.compacted_count + ' compacted') : '',
                        tokStr = (s.tokens_est || 0) + '/' + (s.max_tokens || 1800) + ' tok';
                    return '<span style="display:inline-block;margin:1px 3px 1px 0;padding:2px 6px;border-radius:3px;' +
                        'background:' + badgeBg + ';color:' + badgeFg + ';font-weight:600;">' +
                        esc(s.label || s.scope_key) + ' (' + tokStr +
                        compText + ')</span>';
                }).join(' ');

            html += '<tr style="border-bottom:1px solid #e2e8f0;">' +
                '<td style="padding:7px 8px;vertical-align:top;">' +
                '<strong>' + esc(p.page_title || p.page_key) + '</strong><br/>' +
                '<span style="color:#64748b;font-family:monospace;">' + esc(p.page_key) + '</span>' +
                '</td>' +
                '<td style="padding:7px 8px;vertical-align:top;">' +
                (scopeBadges || '<span style="color:#94a3b8;">—</span>') +
                '</td>' +
                '<td style="padding:7px 8px;vertical-align:top;min-width:140px;">' +
                '<div style="font-weight:600;margin-bottom:3px;">' + used + ' / ' + max + ' tok (' + pct + '%)</div>' +
                '<div style="height:5px;width:100%;background:#e2e8f0;border-radius:3px;overflow:hidden;">' +
                '<div style="height:100%;width:' + pct + '%;background:' + barColor + ';"></div></div>' +
                '</td>' +
                '<td style="padding:7px 8px;vertical-align:top;text-align:right;">' +
                '<button type="button" class="action-default scalable rb-collab-ctx-clear-page"' +
                ' data-page-key="' + esc(p.page_key) + '"' +
                ' style="padding:3px 8px;font-size:11px;">Clear</button>' +
                '</td></tr>';
        });

        html += '</tbody></table>';
        $ctxWrap.html(html);
    }

    function loadContextManagerTable() {
        if (!$ctxWrap.length || !conversationsUrl) {
            return;
        }
        $.ajax({
            url: conversationsUrl,
            method: 'GET',
            dataType: 'json'
        }).done(function (res) {
            renderContextTable((res && res.pages) ? res.pages : []);
        }).fail(function () {
            $ctxWrap.text('Unable to load AI conversation context table.');
        });
    }

    loadContextManagerTable();

    $('#rb-collab-ctx-refresh-btn').on('click', function () {
        loadContextManagerTable();
    });

    $('#rb-collab-ctx-clear-all-btn').on('click', function () {
        var $btn = $(this);
        $btn.prop('disabled', true);
        $.ajax({
            url: clearContextUrl,
            method: 'POST',
            dataType: 'json',
            data: { form_key: window.FORM_KEY, clear_all: 1 }
        }).done(function (res) {
            renderContextTable((res && res.pages) ? res.pages : []);
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $ctxWrap.on('click', '.rb-collab-ctx-clear-page', function () {
        var $btn = $(this),
            pKey = $btn.attr('data-page-key') || '';
        $btn.prop('disabled', true);
        $.ajax({
            url: clearContextUrl,
            method: 'POST',
            dataType: 'json',
            data: { form_key: window.FORM_KEY, page_key: pKey }
        }).done(function (res) {
            renderContextTable((res && res.pages) ? res.pages : []);
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    function renderUsageSummary(usage, prefixText) {
        if (!usage) {
            return;
        }
        var plan = (usage.plan || 'starter').toString().toUpperCase(),
            credits = usage.credits_remaining !== undefined ? usage.credits_remaining : '—',
            keyText = usage.license_key ? ' [' + usage.license_key + ']' : '';

        $msg.css({
            display: 'block',
            background: '#ecfdf5',
            borderColor: '#6ee7b7',
            color: '#065f46'
        }).text(
            (prefixText ? prefixText + ' — ' : '') +
            'Plan: ' + plan + ' • Credits Remaining: ' + credits + ' (Never Expire)' + keyText
        );

        if (usage.upgrade_url) {
            $billingLink.attr('href', usage.upgrade_url).show();
        }
    }

    $('#rb-collab-activate-trial-btn').on('click', function () {
        var $btn = $(this);
        $btn.prop('disabled', true);
        $msg.css({ display: 'block', background: '#f8fafc', borderColor: '#cbd5e1', color: '#334155' })
            .text('Provisioning 30 free Solcart AI starter credits...');

        $.ajax({
            url: activateUrl,
            method: 'POST',
            dataType: 'json',
            data: { form_key: window.FORM_KEY }
        }).done(function (res) {
            if (res && res.success) {
                renderUsageSummary(res.usage || {}, '30 Free Starter Credits Activated & Saved');
                return;
            }
            $msg.css({ display: 'block', background: '#fef2f2', borderColor: '#fecaca', color: '#991b1b' })
                .text((res && res.error) ? res.error : 'Unable to activate starter credits.');
        }).fail(function () {
            $msg.css({ display: 'block', background: '#fef2f2', borderColor: '#fecaca', color: '#991b1b' })
                .text('Request failed while communicating with Solcart AI Gateway.');
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $('#rb-collab-check-status-btn').on('click', function () {
        var $btn = $(this);
        $btn.prop('disabled', true);

        $.ajax({
            url: statusUrl,
            method: 'GET',
            dataType: 'json'
        }).done(function (res) {
            if (res && res.status) {
                renderUsageSummary(res.status, 'Cloud AI Connected');
            }
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });
});
</script>
