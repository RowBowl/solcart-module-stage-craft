<script>
require(['jquery'], function ($) {
    'use strict';

    var conversationsUrl = <?= /* @noEscape */ json_encode($block->getConversationsUrl()) ?>,
        clearContextUrl = <?= /* @noEscape */ json_encode($block->getClearContextUrl()) ?>,
        statusUrl = <?= /* @noEscape */ json_encode($block->getLicenseStatusUrl()) ?>,
        editPageTemplate = <?= /* @noEscape */ json_encode($block->getCmsPageEditUrlTemplate()) ?>,
        viewPageTemplate = <?= /* @noEscape */ json_encode($block->getPageContextViewUrlTemplate()) ?>,
        $tbody = $('#rb-ctx-grid-tbody');

    function esc(val) {
        return $('<div></div>').text(val === null || val === undefined ? '' : String(val)).html();
    }

    function formatTime(isoStr) {
        if (!isoStr) {
            return '—';
        }
        return String(isoStr).replace('T', ' ').substring(0, 19) + ' UTC';
    }

    function buildEditUrl(pageKey) {
        var parts = String(pageKey || '').split(':');
        if (parts[0] === 'cms_page' && parts[1] && parts[1] !== 'new' && parts[1] !== 'global') {
            return editPageTemplate.replace('__ID__', encodeURIComponent(parts[1]));
        }
        return '';
    }

    function buildViewHistoryUrl(pageKey) {
        return viewPageTemplate.replace('__PAGE_KEY__', encodeURIComponent(String(pageKey || '')));
    }

    function renderGrid(pages) {
        if (!Array.isArray(pages) || !pages.length) {
            $('#rb-ctx-kpi-pages').text('0');
            $('#rb-ctx-kpi-scopes').text('0');
            $('#rb-ctx-kpi-tokens').text('0');
            $('#rb-ctx-kpi-compacted').text('0');
            $tbody.html(
                '<tr class="data-row"><td colspan="7" style="padding:24px;text-align:center;color:#64748b;">' +
                'No active AI conversations stored for this store domain. Open a CMS Page in Page Builder and use ' +
                'the Solcart AI Page Scaffolder or Row/Column AI Assistant to start a conversation.' +
                '</td></tr>'
            );
            return;
        }

        var totalScopes = 0,
            totalTokens = 0,
            totalCompacted = 0,
            rowsHtml = '';

        pages.forEach(function (p, idx) {
            var scopes = Array.isArray(p.scopes) ? p.scopes : [],
                scaffolderScope = null,
                blockScopes = [],
                used = p.total_tokens_est || 0,
                max = p.max_tokens_budget || 16000,
                pct = Math.min(100, Math.round((used / max) * 100)),
                barColor = pct > 80 ? '#e11d48' : (pct > 50 ? '#f59e0b' : '#0284c7'),
                editUrl = buildEditUrl(p.page_key);

            totalScopes += scopes.length;
            totalTokens += used;
            totalCompacted += (p.compacted_count || 0);

            scopes.forEach(function (s) {
                if (s.scope_type === 'scaffolder') {
                    scaffolderScope = s;
                } else {
                    blockScopes.push(s);
                }
            });

            var scaffolderHtml = '<span style="color:#94a3b8;">No scaffolder history</span>';
            if (scaffolderScope) {
                var sTok = (scaffolderScope.tokens_est || 0) + ' / ' + (scaffolderScope.max_tokens || 6000) + ' tok',
                    sTurns = (scaffolderScope.turns_count || 0) + ' turn(s)',
                    sComp = scaffolderScope.compacted_count
                        ? (' • ' + scaffolderScope.compacted_count + ' auto-compacted')
                        : '';
                scaffolderHtml = '<div style="display:inline-flex;align-items:center;gap:6px;padding:4px 8px;' +
                    'background:#fff1f2;border:1px solid #fecdd3;border-radius:4px;' +
                    'color:#be123c;font-size:12px;">' +
                    '<span><strong>Page Scaffolder:</strong> ' + esc(sTok) + ' (' + esc(sTurns + sComp) + ')</span>' +
                    '<button type="button" class="rb-ctx-clear-scope" data-page-key="' + esc(p.page_key) + '"' +
                    ' data-scope-key="scaffolder" title="Clear Page Scaffolder history"' +
                    ' style="border:none;background:transparent;color:#be123c;font-weight:700;cursor:pointer;">' +
                    '&times;</button></div>';
            }

            var blocksHtml = '<span style="color:#94a3b8;">No block conversations</span>';
            if (blockScopes.length) {
                blocksHtml = '<div style="display:flex;flex-wrap:wrap;gap:6px;">';
                blockScopes.forEach(function (b) {
                    var bTok = (b.tokens_est || 0) + '/' + (b.max_tokens || 1800) + ' tok',
                        bTurns = (b.turns_count || 0) + ' turn(s)',
                        bComp = b.compacted_count ? (' • ' + b.compacted_count + ' compacted') : '';
                    blocksHtml += '<div style="display:inline-flex;align-items:center;gap:6px;padding:4px 8px;' +
                        'background:#f0f9ff;border:1px solid #bae6fd;border-radius:4px;' +
                        'color:#0369a1;font-size:12px;">' +
                        '<span><strong>' + esc(b.label || b.scope_key) + ':</strong> ' +
                        esc(bTok + ' (' + bTurns + bComp + ')') + '</span>' +
                        '<button type="button" class="rb-ctx-clear-scope" data-page-key="' + esc(p.page_key) + '"' +
                        ' data-scope-key="' + esc(b.scope_key) + '" title="Clear this block conversation"' +
                        ' style="border:none;background:transparent;color:#0369a1;font-weight:700;cursor:pointer;">' +
                        '&times;</button></div>';
                });
                blocksHtml += '</div>';
            }

            var viewUrl = buildViewHistoryUrl(p.page_key),
                editLinkHtml = editUrl
                ? '<a href="' + esc(editUrl) + '"' +
                  ' style="margin-right:10px;font-weight:600;color:#006bb4;">Edit Page</a>'
                : '';

            rowsHtml += '<tr class="data-row rb-ctx-page-row' + (idx % 2 === 1 ? ' _odd-row' : '') + '"' +
                ' data-view-url="' + esc(viewUrl) + '" style="cursor:pointer;">' +
                '<td><code style="font-size:12px;color:#0f172a;">' + esc(p.page_key) + '</code></td>' +
                '<td><a href="' + esc(viewUrl) + '" style="font-weight:700;color:#0f172a;text-decoration:none;">' +
                esc(p.page_title || p.page_key) + ' &rarr;</a></td>' +
                '<td>' + scaffolderHtml + '</td>' +
                '<td>' + blocksHtml + '</td>' +
                '<td>' +
                '<div style="font-weight:600;font-size:12px;margin-bottom:4px;">' +
                esc(used + ' / ' + max + ' tok (' + pct + '%)') + '</div>' +
                '<div style="height:6px;width:100%;background:#e2e8f0;border-radius:3px;overflow:hidden;">' +
                '<div style="height:100%;width:' + pct + '%;background:' + barColor + ';"></div></div>' +
                '</td>' +
                '<td style="font-size:12px;color:#475569;">' + esc(formatTime(p.updated_at)) + '</td>' +
                '<td style="text-align:right;white-space:nowrap;">' +
                '<a href="' + esc(viewUrl) + '"' +
                ' style="margin-right:10px;font-weight:600;color:#e11d48;">View History</a>' +
                editLinkHtml +
                '<button type="button" class="action-default scalable rb-ctx-clear-page"' +
                ' data-page-key="' + esc(p.page_key) + '" style="padding:4px 10px;font-size:12px;">' +
                'Clear Page</button>' +
                '</td></tr>';
        });

        $('#rb-ctx-kpi-pages').text(String(pages.length));
        $('#rb-ctx-kpi-scopes').text(String(totalScopes));
        $('#rb-ctx-kpi-tokens').text(totalTokens.toLocaleString());
        $('#rb-ctx-kpi-compacted').text(String(totalCompacted));
        $tbody.html(rowsHtml);
    }

    function loadConversations() {
        $.ajax({
            url: conversationsUrl,
            method: 'GET',
            dataType: 'json',
            global: false
        }).done(function (res) {
            renderGrid((res && res.pages) ? res.pages : []);
        }).fail(function () {
            $tbody.html(
                '<tr class="data-row"><td colspan="7" style="padding:20px;text-align:center;color:#be123c;">' +
                'Unable to load AI conversation history from Solcart AI Gateway.' +
                '</td></tr>'
            );
        });
    }

    function loadPlanStatus() {
        if (!statusUrl) {
            return;
        }
        $.ajax({
            url: statusUrl,
            method: 'GET',
            dataType: 'json',
            global: false
        }).done(function (res) {
            if (res && res.status) {
                var plan = (res.status.plan || 'starter').toString().toUpperCase(),
                    cr = res.status.credits_remaining !== undefined ? res.status.credits_remaining : '—';
                $('#rb-ctx-plan-badge').html(
                    '&#10022; Solcart AI (' + esc(plan) + ' &bull; ' + esc(cr) + ' credits)'
                );
            }
        });
    }

    loadConversations();
    loadPlanStatus();

    $('#rb-ctx-refresh-btn').on('click', function () {
        loadConversations();
    });

    $('#rb-ctx-clear-all-btn').on('click', function () {
        var $btn = $(this);
        $btn.prop('disabled', true);
        $.ajax({
            url: clearContextUrl,
            method: 'POST',
            dataType: 'json',
            global: false,
            data: { form_key: window.FORM_KEY, clear_all: 1 }
        }).done(function (res) {
            renderGrid((res && res.pages) ? res.pages : []);
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $tbody.on('click', '.rb-ctx-clear-page', function (event) {
        event.stopPropagation();
        var $btn = $(this),
            pKey = $btn.attr('data-page-key') || '';
        $btn.prop('disabled', true);
        $.ajax({
            url: clearContextUrl,
            method: 'POST',
            dataType: 'json',
            global: false,
            data: { form_key: window.FORM_KEY, page_key: pKey }
        }).done(function (res) {
            renderGrid((res && res.pages) ? res.pages : []);
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $tbody.on('click', '.rb-ctx-clear-scope', function (event) {
        event.stopPropagation();
        var $btn = $(this),
            pKey = $btn.attr('data-page-key') || '',
            sKey = $btn.attr('data-scope-key') || '';
        $btn.prop('disabled', true);
        $.ajax({
            url: clearContextUrl,
            method: 'POST',
            dataType: 'json',
            global: false,
            data: { form_key: window.FORM_KEY, page_key: pKey, scope_key: sKey }
        }).done(function (res) {
            renderGrid((res && res.pages) ? res.pages : []);
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $tbody.on('click', '.rb-ctx-page-row', function (event) {
        if ($(event.target).closest('button, a').length) {
            return;
        }
        var viewUrl = $(this).attr('data-view-url') || '';
        if (viewUrl) {
            window.location.href = viewUrl;
        }
    });
});
</script>
