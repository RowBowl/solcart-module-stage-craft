<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="solcart_stagecraft_comment" resource="default" engine="innodb"
           comment="Solcart StageCraft PageBuilder Collaborative Comments">
        <column xsi:type="int" name="comment_id" unsigned="true" nullable="false" identity="true"
                comment="Comment ID"/>
        <column xsi:type="int" name="parent_id" unsigned="true" nullable="true"
                comment="Parent Comment ID for Threaded Replies"/>
        <column xsi:type="varchar" name="instance_key" nullable="false" length="191"
                comment="PageBuilder Instance Key (entity_type:entity_id:field_name)"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="64" default="cms_page"
                comment="Entity Type (cms_page, cms_block, catalog_product, catalog_category)"/>
        <column xsi:type="varchar" name="entity_id" nullable="false" length="64" default="0"
                comment="Entity Identifier"/>
        <column xsi:type="varchar" name="field_name" nullable="false" length="128" default="content"
                comment="Form Field Name"/>
        <column xsi:type="varchar" name="target_type" nullable="false" length="64" default="row"
                comment="Target Content Type (page, row, text, banner, etc.)"/>
        <column xsi:type="varchar" name="target_id" nullable="false" length="128" default="page"
                comment="Stable Target UUID or page"/>
        <column xsi:type="varchar" name="structural_path" nullable="true" length="255"
                comment="Fallback Structural Path in Stage (e.g. row:0)"/>
        <column xsi:type="varchar" name="target_label" nullable="true" length="128"
                comment="Human Readable Target Label"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true"
                comment="Author Admin User ID"/>
        <column xsi:type="varchar" name="author_name" nullable="false" length="128"
                comment="Author Display Name"/>
        <column xsi:type="varchar" name="author_username" nullable="false" length="128"
                comment="Author Admin Username"/>
        <column xsi:type="text" name="comment_text" nullable="false"
                comment="Comment Body Text"/>
        <column xsi:type="text" name="mentions_json" nullable="true"
                comment="JSON Array of Mentioned Admin Usernames"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="open"
                comment="Thread Status (open, resolved)"/>
        <column xsi:type="int" name="resolved_by" unsigned="true" nullable="true"
                comment="Resolved By Admin User ID"/>
        <column xsi:type="varchar" name="resolved_by_name" nullable="true" length="128"
                comment="Resolved By Admin Display Name"/>
        <column xsi:type="timestamp" name="resolved_at" nullable="true" on_update="false"
                comment="Resolved Timestamp"/>
        <column xsi:type="decimal" name="pin_x" scale="2" precision="6" unsigned="false" nullable="true"
                comment="Relative Horizontal Pin Coordinate (%)"/>
        <column xsi:type="decimal" name="pin_y" scale="2" precision="6" unsigned="false" nullable="true"
                comment="Relative Vertical Pin Coordinate (%)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="comment_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="SOLCART_STAGECRAFT_COMMENT_PARENT_ID_SOLCART_STAGECRAFT_COMMENT_COMMENT_ID"
                    table="solcart_stagecraft_comment" column="parent_id"
                    referenceTable="solcart_stagecraft_comment" referenceColumn="comment_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="SOLCART_STAGECRAFT_COMMENT_ADMIN_USER_ID_ADMIN_USER_USER_ID"
                    table="solcart_stagecraft_comment" column="admin_user_id"
                    referenceTable="admin_user" referenceColumn="user_id"
                    onDelete="SET NULL"/>

        <index referenceId="SOLCART_STAGECRAFT_COMMENT_INSTANCE_KEY_TARGET_TYPE_TARGET_ID" indexType="btree">
            <column name="instance_key"/>
            <column name="target_type"/>
            <column name="target_id"/>
        </index>
        <index referenceId="SOLCART_STAGECRAFT_COMMENT_ENTITY_TYPE_ENTITY_ID" indexType="btree">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </index>
        <index referenceId="SOLCART_STAGECRAFT_COMMENT_PARENT_ID" indexType="btree">
            <column name="parent_id"/>
        </index>
        <index referenceId="SOLCART_STAGECRAFT_COMMENT_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
