<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Solcart_StageCraft::collaboration"
                          title="PageBuilder Collaboration &amp; AI" sortOrder="20">
                    <resource id="Solcart_StageCraft::view"
                              title="View Comments" sortOrder="10"/>
                    <resource id="Solcart_StageCraft::comment"
                              title="Create and Reply to Comments" sortOrder="20"/>
                    <resource id="Solcart_StageCraft::resolve"
                              title="Resolve and Reopen Threads" sortOrder="30"/>
                    <resource id="Solcart_StageCraft::ai"
                              title="Use AI Assistant" sortOrder="35"/>
                    <resource id="Solcart_StageCraft::delete"
                              title="Delete Comments" sortOrder="40"/>
                    <resource id="Solcart_StageCraft::config"
                              title="Configuration" sortOrder="50"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
