<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="solcart_stagecraft" translate="label" type="text" sortOrder="910"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Solcart StageCraft — PageBuilder Collaboration &amp; AI</label>
            <tab>general</tab>
            <resource>Solcart_StageCraft::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Collaborative Comments &amp; Review Settings</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable PageBuilder Collaboration</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enables collaborative comment threads inside Magento Page Builder.</comment>
                </field>
                <field id="enable_page_comments" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Page-Level Comments</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Allows admin users to leave review notes at the Page / Stage level.</comment>
                </field>
                <field id="enable_floating_pins" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Show Floating Comment Badges on Rows &amp; Columns</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Displays floating comment pills on Page Builder Rows and Columns.</comment>
                </field>
                <field id="polling_interval" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Comment Auto-Refresh Interval (Seconds)</label>
                    <validate>validate-number</validate>
                    <comment>
                        Automatically polls the database for the latest collaborative comment threads, replies, and resolutions on the open page so multiple admin users stay in sync. Set to 0 to disable background polling, or e.g. 30 to fetch new comment data every 30 seconds.
                    </comment>
                </field>
            </group>
            <group id="ai" translate="label comment" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Solcart AI Assistant (Powered by Solcart AI)</label>
                <comment>
                    Managed AI features for PageBuilder page scaffolding, Row/Column building, and comment resolution.
                </comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Solcart AI</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch for Solcart AI features in Page Builder.</comment>
                </field>
                <field id="enable_page_scaffolder" translate="label comment" type="select" sortOrder="15"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable AI Page Scaffolder (Above Content)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        Displays the inline Solcart AI Page Scaffolder chat above Content for full-page drafting.
                    </comment>
                </field>
                <field id="enable_stage_ai" translate="label comment" type="select" sortOrder="18"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Stage-Level AI (Rows, Columns &amp; Page Audit)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        Enables AI hover buttons on Rows and Columns and Run AI Page Audit in the stage header.
                    </comment>
                </field>
                <field id="license_key" translate="label comment" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Solcart AI License Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Enter your Solcart AI subscription key (leave blank to use trial mode).</comment>
                </field>
                <field id="trial_activation" translate="label comment" type="button" sortOrder="25"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Instant Cloud Trial &amp; Billing</label>
                    <frontend_model>Solcart\StageCraft\Block\Adminhtml\System\Config\TrialActivation</frontend_model>
                    <comment>
                        Provision a persistent 14-day Solcart AI trial key for this store domain or manage billing.
                    </comment>
                </field>
                <field id="brand_voice" translate="label comment" type="textarea" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Brand Voice &amp; Store Context (Optional)</label>
                    <comment>Describe your brand tone and target audience to guide AI copy generation.</comment>
                </field>
                <field id="timeout" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Request Timeout (Seconds)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <comment>Maximum wait time for Cloud AI responses (default: 45 seconds).</comment>
                </field>
            </group>
        </section>
    </system>
</config>
